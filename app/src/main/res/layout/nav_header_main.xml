<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hero_navy"
    android:padding="@dimen/nav_header_main_root_padding">

    <TextView
        android:id="@+id/navHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/nav_header_title"
        android:textColor="@color/parchment_light"
        android:textSize="@dimen/nav_header_main_title_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nav_header_main_subtitle_margin_top"
        android:text="@string/nav_header_subtitle"
        android:textColor="@color/parchment"
        android:textSize="@dimen/nav_header_main_subtitle_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navHeaderTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
